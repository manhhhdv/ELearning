# Mẫu biến môi trường cho backend khi chạy production bằng Docker.
# Sao chép thành backend/.env.production rồi điền giá trị thật:
#   cp backend/.env.production.example backend/.env.production
# File này được nạp vào container qua `env_file` trong docker-compose.prod.yml.

# ----- Máy chủ -----
PORT=8082
APP_ENV=production
# Domain thật của frontend trên Cloudflare Pages (dùng cho các đường dẫn tuyệt đối, nếu có).
FRONTEND_URL=https://your-app.pages.dev
# Domain(s) được phép gọi API bằng CORS, cách nhau bằng dấu phẩy nếu có nhiều domain
# (ví dụ thêm domain tuỳ chỉnh cạnh domain *.pages.dev mặc định).
ALLOW_ORIGINS=https://your-app.pages.dev

# ----- Cơ sở dữ liệu -----
# docker-compose.prod.yml tự ghi đè biến này để trỏ vào service `postgres` nội bộ trong mạng Docker
# (đọc POSTGRES_USER/PASSWORD/DB từ file .env ở thư mục gốc) — không cần sửa dòng dưới.
DATABASE_URL=postgres://elearning:elearning@postgres:5432/elearning?sslmode=disable

# ----- Phiên đăng nhập -----
# BẮT BUỘC: sinh chuỗi ngẫu nhiên, backend từ chối khởi động nếu để trống khi APP_ENV=production.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

# ----- Tài khoản quản trị khởi tạo -----
# Chỉ được tạo khi database chưa có admin nào. Đổi mật khẩu ngay sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=doi-mat-khau-nay-truoc-khi-chay
SEED_ADMIN_NAME=Quản trị hệ thống

# ----- Đăng nhập bằng Google (để trống thì nút Google tự ẩn) -----
# Tạo tại https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorized redirect URI phải trùng đúng GOOGLE_REDIRECT_URL bên dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.yourdomain.com/api/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_AUTO_PROVISION_ROLE=
