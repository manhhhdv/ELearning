# ----- Máy chủ -----
PORT=8082
APP_ENV=development
FRONTEND_URL=http://localhost:3006
ALLOW_ORIGINS=http://localhost:3006

# ----- Cơ sở dữ liệu -----
# Khớp với docker-compose.yml ở thư mục gốc (Postgres chạy ở cổng 5433)
DATABASE_URL=postgres://elearning:elearning@localhost:5433/elearning?sslmode=disable

# ----- Phiên đăng nhập -----
# BẮT BUỘC đổi trước khi chạy production. Sinh nhanh: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-truoc-khi-len-production
JWT_TTL=24h

# ----- Tài khoản quản trị khởi tạo -----
# Chỉ được tạo khi database chưa có admin nào. Đổi mật khẩu ngay sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=admin@elearning.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Quản trị hệ thống

# Tạo sẵn 4 lớp học mẫu (Toán, Ngữ văn, Vật lý, Hóa học) lúc khởi động, để có
# ngay dữ liệu demo. Mặc định bật ở mọi môi trường trừ production; để trống
# dòng này là đủ, chỉ cần khai báo khi muốn ghi đè (VD: đặt true để seed lên
# production, hoặc false để tắt hẳn kể cả ở development).
# SEED_SAMPLE_SUBJECTS=true

# ----- Đăng nhập bằng Google (để trống thì nút Google tự ẩn) -----
# Tạo tại https://console.cloud.google.com/apis/credentials → OAuth client ID → Web application
# Authorized redirect URI phải trùng đúng GOOGLE_REDIRECT_URL bên dưới.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8082/api/auth/google/callback
# Giới hạn domain email được phép đăng nhập, cách nhau bằng dấu phẩy. Để trống = không giới hạn.
GOOGLE_ALLOWED_DOMAINS=
# Email lạ đăng nhập Google lần đầu sẽ được tạo tài khoản với vai trò này (student|trainer).
# Để trống = chỉ tài khoản do admin tạo sẵn mới đăng nhập được.
GOOGLE_AUTO_PROVISION_ROLE=

# ----- Trí tuệ nhân tạo (để trống thì các nút AI tự ẩn) -----
# Khuyến nghị cấu hình ở giao diện: Quản lý → Cấu hình AI (có nút kiểm tra kết nối,
# đổi khoá có hiệu lực ngay, không cần khởi động lại). Giá trị ở đây chỉ là dự phòng
# khi hệ thống chưa lưu cấu hình nào — tiện cho môi trường phát triển và triển khai tự động.
# Hai biến dưới đây chỉ tạo được một kênh Gemini. Muốn dùng nhiều nhà cung cấp (OpenAI,
# Anthropic, Groq, OpenRouter…) và tự xoay vòng khi một khoá hết hạn mức thì khai báo
# danh sách kênh ở giao diện Quản lý → Cấu hình AI.
# Lấy khoá tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Để trống = dùng model mặc định (gemini-2.5-flash).
GEMINI_MODEL=
