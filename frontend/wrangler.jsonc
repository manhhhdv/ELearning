{
  // Đổi "name" thành tên Worker thật bạn muốn dùng — nó quyết định domain mặc định
  // <name>.<subdomain>.workers.dev và là định danh của Worker trên tài khoản Cloudflare.
  // Cấu hình gốc (top-level) này dùng cho production: `wrangler deploy` không kèm `--env`.
  "name": "tap-huan",
  "compatibility_date": "2026-08-18",
  "main": "worker/index.js",

  // BACKEND_ORIGIN: domain thật của backend (Docker + Tunnel/Caddy, xem DEPLOY.md mục 3).
  // worker/index.js đọc biến này để proxy /api/*.
  "vars": {
    "BACKEND_ORIGIN": "https://api.yourdomain.com",
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Request không khớp file tĩnh nào (route con của React Router) trả về index.html thay vì 404.
    "not_found_handling": "single-page-application",
    // Bắt buộc /api/* luôn chạy qua worker/index.js trước, không để assets binding trả 404.
    "run_worker_first": ["/api/*"],
  },

  // Môi trường khác production. `main`, `compatibility_date`, `assets` tự kế thừa từ trên xuống —
  // chỉ "vars" KHÔNG được kế thừa (quy định của Wrangler) nên phải khai lại ở mỗi env bên dưới.
  // Không đặt "name" riêng thì Cloudflare tự đặt tên Worker theo dạng "<name>-<env>", ở đây là
  // "tap-huan-staging" — không đụng tới Worker production.
  //
  // Deploy: wrangler deploy --env staging   (hoặc: deploy/deploy-frontend.sh --env staging)
  // Thêm môi trường khác (vd preview) thì copy nguyên khối "staging" bên dưới, đổi tên khối và giá
  // trị BACKEND_ORIGIN.
  "env": {
    "staging": {
      "vars": {
        "BACKEND_ORIGIN": "https://api-staging.yourdomain.com",
      },
    },
  },
}
