# Biến dùng bởi `docker compose -f docker-compose.prod.yml` để dựng Postgres và
# (tuỳ chọn) Caddy / Cloudflare Tunnel. Khác với backend/.env.production — file đó
# cấu hình riêng cho ứng dụng backend.
# Sao chép thành .env rồi điền giá trị thật: cp .env.example .env

# ----- PostgreSQL -----
POSTGRES_USER=elearning
POSTGRES_PASSWORD=doi-mat-khau-nay-truoc-khi-len-production
POSTGRES_DB=elearning

# ----- Caddy (chỉ cần khi chạy với `--profile proxy`) -----
# Domain trỏ tới server này, dùng để Caddy tự xin chứng chỉ TLS (Let's Encrypt).
DOMAIN=api.yourdomain.com

# ----- Cloudflare Tunnel (chỉ cần khi chạy với `--profile tunnel`) -----
# Lấy token ở Cloudflare Zero Trust → Networks → Tunnels → tạo tunnel → Docker.
CLOUDFLARE_TUNNEL_TOKEN=
