# Cấu hình backend cho troly.hoctap.space — đặt thành file `backend.env` cạnh compose trên server.
PORT=8082
APP_ENV=production
FRONTEND_URL=https://troly.hoctap.space
ALLOW_ORIGINS=https://troly.hoctap.space

# docker-compose.yml tự ghi đè DATABASE_URL trỏ vào service postgres nội bộ.

# BẮT BUỘC: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

# Tài khoản quản trị khởi tạo (chỉ tạo khi database chưa có admin). Đổi mật khẩu sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Quản trị hệ thống

# Tạo sẵn các lớp học mẫu lớp 1–12 (Toán, Tiếng Việt/Ngữ văn, Tiếng Anh) lúc khởi động.
SEED_SAMPLE_SUBJECTS=true

# Đăng nhập Google (để trống thì nút Google tự ẩn).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://troly.hoctap.space/api/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_AUTO_PROVISION_ROLE=

# Khoá AI nên cấu hình ở giao diện: Quản lý → Cấu hình AI.
GEMINI_API_KEY=
GEMINI_MODEL=
