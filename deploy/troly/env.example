# Biến cho docker-compose.yml của troly.hoctap.space — đặt thành file `.env` cạnh compose trên server.
# Sinh mật khẩu: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=elearning
POSTGRES_PASSWORD=
POSTGRES_DB=elearning
# Cổng backend bind trên 127.0.0.1 của server, phải khớp proxy_pass trong cấu hình Nginx.
BACKEND_PORT_HOST=8093
